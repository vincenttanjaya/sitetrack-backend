# Compose reads this file only if copied to .env. Every value is optional for Compose.
API_PORT=8080
BUSINESS_TIMEZONE=Asia/Muscat
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Set a random value of at least 32 bytes for a persistent signing key.
JWT_SECRET=

# For go run against your own PostgreSQL instance, export DATABASE_URL and optionally APP_ADDR.
# DATABASE_URL=postgres://sitetrack:your-password@127.0.0.1:5432/sitetrack?sslmode=disable
# APP_ADDR=:8080
